LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
EMBEDDING_MODEL=text-embedding-3-small

# JWT 서명 시크릿 (필수). 충분히 긴 임의 문자열로 설정. 미설정 시 기동 거부됨.
# 생성 예: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# LangSmith 트레이싱 (https://smith.langchain.com)
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=company-rag

# CORS allowed origins (comma-separated). Defaults to http://localhost:5173 for Vite dev.
CORS_ORIGINS=http://localhost:5173

# OpenFGA (docker compose up 후 scripts/fga_init.sh 실행하여 FGA_STORE_ID 획득)
FGA_API_URL=http://localhost:8080
FGA_STORE_ID=
FGA_API_KEY=

# PostgreSQL (FGA 캐시 + user_doc_grants 테이블)
POSTGRES_DSN=postgresql://fga:fga@localhost:5432/app
SESSION_STORE_TYPE=postgres
FGA_CACHE_BACKEND=postgres
FGA_CACHE_TTL_SECONDS=60

# 가상 업무 DB (ADR-0020): 자율 SQL 도구가 붙는 business 스키마 read-only 제한계정.
# scripts/seed_business.py 실행 시 SQL_TOOL_RO_PASSWORD로 계정 비밀번호 설정(미설정 시 dev 기본값).
# 제한계정 접속 DSN(SQL 도구 전용, PR-3에서 사용) — public 스키마 접근 불가.
SQL_TOOL_RO_PASSWORD=sql_tool_ro_dev
SQL_TOOL_DSN=postgresql://sql_tool_ro:sql_tool_ro_dev@localhost:5432/app