LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Vector Store: chroma (기본값)
VECTOR_STORE=chroma
CHROMA_MODE=embedded
CHROMA_PATH=./.chroma

# Vector Store: qdrant (VECTOR_STORE=qdrant 사용 시 아래 항목 입력)
#VECTOR_STORE=qdrant
#QDRANT_URL=https://xxx.qdrant.io:6333
#QDRANT_API_KEY=your-api-key
#QDRANT_COLLECTION=documents

EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# LangSmith 트레이싱 (https://smith.langchain.com)
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=company-rag

# CORS allowed origins (comma-separated). Defaults to http://localhost:5173 for Vite dev.
CORS_ORIGINS=http://localhost:5173

# OpenFGA (docker compose up 후 scripts/fga_init.sh 실행하여 FGA_STORE_ID 획득)
FGA_API_URL=http://localhost:8080
FGA_STORE_ID=
FGA_API_KEY=

# PostgreSQL (FGA 캐시 + user_doc_grants 테이블)
POSTGRES_DSN=postgresql://fga:fga@localhost:5432/app
FGA_CACHE_BACKEND=postgres
FGA_CACHE_TTL_SECONDS=60