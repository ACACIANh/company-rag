model
  schema 1.1

type user

type role
  relations
    define member: [user]          # c_level 같은 전사 역할

type department
  relations
    define member: [user]
    define admin: [user]           # 부서 관리자 — 자기 부서 멤버십 위임 (ADR-0046)

type folder
  relations
    define parent: [folder]

    # 부서 명시 권한 (private 폴더에 복수 부여 가능)
    define dept_viewer: [department#member]
    define dept_access: dept_viewer or dept_access from parent

    # 전 직원 공개 (루트 user:* → 상속)
    define public_viewer: [user:*]
    define public_access: public_viewer or public_access from parent

    # private 표식 (이 서브트리는 공개 차단)
    define private_flag: [user:*] or private_flag from parent

    # 전사 상위 열람권 (private도 뚫음, 루트에 부여하면 서브트리 상속)
    define super_reader: [role#member] or super_reader from parent

    define can_read: super_reader or dept_access or (public_access but not private_flag)

type capability
  relations
    # SQL 권한(매트릭스 정리): 단순 SELECT만 allow_*(즉시 허용) 유지,
    # 그 외 모든 위험군은 justify_*(사유 기재·이력) 전용. allow_* relation 자체를 두지 않는다.
    define allow_select:          [user:*, department#member, role#member]
    define justify_select:        [user:*, department#member, role#member]
    define justify_bulk_select:   [user:*, department#member, role#member]
    define justify_update_delete: [user, department#member, role#member]
    define justify_ddl:           [user, department#member, role#member]
    # 권한 관리(ADR-0029): capability:admin 인스턴스가 사용 — grant는 항상 사유 기재(justify_grant 전용)
    define justify_grant:         [user, department#member, role#member]

# 업무 DB 테이블 단위 접근권 (ADR-0047). table:employees / table:sales 인스턴스가 사용.
# 위험도 게이트(capability:sql)와 직교 — "어느 테이블이냐"만 본다.
type table
  relations
    define can_access: [user, department#member, role#member]
